# WorldSim 环境变量（唯一清单 = docs/tasks/00-总览与里程碑.md §2 附表，A13：新增 env 先登记该表）
# 复制本文件为 .env 并填真值；.env 永不入库（.gitignore 强制），权限 600。

# 主库 DSN（00 §2 附表 T-ENV-05 行；04 §1.6）。开发期指向 127.0.0.1:5432/worldsim（00 §1 A1）
WSIM_PG_DSN=postgresql://worldsim:<dev_password>@127.0.0.1:5432/worldsim

# 智谱 GLM 单 key（00 §1 A3，base 走 models.yaml）。M0 起需真值：免费档 glm-4.5-flash/glm-4-flash 冒烟（00 §1 A9）
WSIM_ZHIPU_API_KEY=

# 变速表 / 路由价格参数阈值表（00 §2 附表 T-ENV-05 行；路径相对 server/，调用约定 00 §1 A14）
WSIM_SPEED_TABLE=config/speed_table.yaml
WSIM_MODELS_CONFIG=config/models.yaml

# 世界参数 / 人设（工程默认，docs/tasks/01-脚手架与数据库.md §6 D7）
WSIM_WORLD_CONFIG=config/world.yaml
WSIM_AGENTS_CONFIG=config/agents.yaml

# 回放开关：off|replay，默认 off（00 §2 附表/04 §1.6 三方对齐，round2 §A.5）
WSIM_REPLAY_MODE=off

# 日志级别，消费归 T-ENV-06（04 §1.6）
WSIM_LOG_LEVEL=INFO

# embedding 后端：local|cloud，默认 local=开发期本地 bge-m3（00 §1 A10）；cloud=充值后切智谱 embedding-3 备选档
WSIM_EMBED_BACKEND=local

# —— 以下键不在本任务（T-ENV-05），届时由对应任务先登记 00 §2 附表再向本文件追加（00 §1 A13）——
# WSIM_COST_LIMIT_CNY_PER_SIMDAY：M2 已回填（T-LLM-12，2026-09-25 实测免费档 ¥0/模拟日；付费档充值后复测改写）
WSIM_COST_LIMIT_CNY_PER_SIMDAY=0
# M4 观察端 obs-api（T-WEB-02 追加，00 §2 附表 D5）
# WSIM_OBS_PG_DSN：缺省回退 WSIM_PG_DSN（M4 读主库 obs 白名单层；M6 切副本 DSN 零代码变更，00 §1 A5）
WSIM_OBS_PG_DSN=
WSIM_OBS_PORT=8080
WSIM_OBS_TOKEN_DB=var/observe/tokens.db
# —— M6 同步副本（T-SYN-03 追加，00 §2 附表；07 文档偏差表 D2）——
# 副本库 DSN（T-SYN-06 replica_init.sh 建库/角色；应用账号 worldsim_ingest）
WSIM_REPLICA_PG_DSN=postgresql://worldsim_ingest:<dev_password>@127.0.0.1:5432/worldsim_replica
# 摄入 API 绑定（FastAPI/uvicorn；开发期 loopback）
WSIM_INGEST_BIND=127.0.0.1:9100
# 出站帧落盘开关（JSONL 追加；空=关闭）。必过项①抓包证据源（T-SYN-11）
WSIM_SYNC_FRAME_DUMP=
# 断网演练断网时长（秒，默认 3600；演练可用小值加速）
WSIM_DRILL_OUTAGE_S=3600
# HTTPS 回退 base URL（T-SYN-04 消费；与摄入 API 同进程）
WSIM_CLOUD_INGEST_HTTPS=http://127.0.0.1:9100
# 出站同步 WS 地址 / 摄入 token（开发期 loopback 明文值；上线换 wss + 强 token，服务侧只存哈希）
WSIM_CLOUD_INGEST_URL=ws://127.0.0.1:9100/v1/ingest/ws
WSIM_INGEST_TOKEN=dev-ingest-token
