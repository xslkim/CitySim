# WorldSim 观察端单元（08 T-OPS-04；04 §1.4 worldsim-web.service = obs-api + 静态/WS 订阅）
[Unit]
Description=WorldSim obs-api（观察端 REST + WS；只读账号 obs_ro，05 §5）
After=postgresql.service worldsim-ingest.service

[Service]
Type=simple
WorkingDirectory=/opt/worldsim/server
EnvironmentFile=/opt/worldsim/.env
ExecStart=/bin/sh -c '%h/.local/bin/uv run uvicorn worldsim.observe.app:app \
  --port ${WSIM_OBS_PORT:-8080}'
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
