# ============================================================================
# WorldSim 部署环境模板（08 T-OPS-04；04 §1.6 环境配置项全表 + 00 §1 A3）
# 规则：只写变量名与注释，不写任何真实值；密钥类权限 600、不进 git（04 §11.2）。
# 唯一清单基准 = docs/tasks/00-总览与里程碑.md §2 附表（A13：新增 env 先登记附表）。
# 使用：cp deploy/worldsim.env.example /etc/worldsim/worldsim.env && chmod 600 && 填值
# ============================================================================

# ---- 主库与内核（附表 T-ENV-05 行）----
WSIM_PG_DSN=                  # 主库 DSN postgresql://worldsim:<pwd>@127.0.0.1:5432/worldsim
WSIM_ZHIPU_API_KEY=           # 智谱 GLM 单 key（A3 主供；权限 600、不进 git）
WSIM_SPEED_TABLE=             # 默认 server/config/speed_table.yaml
WSIM_MODELS_CONFIG=           # 默认 server/config/models.yaml（含 thresholds: 段）
WSIM_WORLD_CONFIG=            # 默认 server/config/world.yaml
WSIM_AGENTS_CONFIG=           # 默认 server/config/agents.yaml
WSIM_REPLAY_MODE=off          # off|replay（replay 时 live 主循环拒跑，04 §5.3）
WSIM_LOG_LEVEL=INFO           # T-ENV-06 logging 消费
WSIM_EMBED_BACKEND=local      # local=本机 bge-m3（A10）| cloud=智谱 embedding-3（充值后）

# ---- 熔断基线（附表 M2 回填行）----
WSIM_COST_LIMIT_CNY_PER_SIMDAY=   # ¥/模拟日上限；M2 实测后写死（A6；未回填前只告警不动作，08 D11）

# ---- 观察端 obs-api（附表 T-WEB-02 行，M4 段）----
WSIM_OBS_PG_DSN=              # 观察端 DSN；缺省回退 WSIM_PG_DSN；M6 起指 worldsim_replica（A5）
WSIM_OBS_PORT=8080            # 03 §8.1
WSIM_OBS_TOKEN_DB=            # token 库路径（默认 var/observe/tokens.db）

# ---- 同步副本（附表 T-SYN-03 行，M6 段）----
WSIM_REPLICA_PG_DSN=          # 副本库 DSN（摄入 API/derived worker 消费；账号 worldsim_ingest）
WSIM_INGEST_BIND=             # 摄入 API 绑定（开发期 127.0.0.1:9100，07 D2）
WSIM_SYNC_FRAME_DUMP=         # 出站帧落盘 JSONL 路径（空=关闭；必过项①抓包证据源）
WSIM_DRILL_OUTAGE_S=3600      # 断网演练断网时长（秒）
WSIM_CLOUD_INGEST_HTTPS=      # HTTPS 回退 base URL（T-SYN-04；上线 = https://cloud 端）
WSIM_CLOUD_INGEST_URL=        # 出站 WS 地址（上线 = wss://cloud/v1/ingest/ws；内核 sync 协程开关）
WSIM_INGEST_TOKEN=            # 摄入 Bearer token（权限 600、不进 git；服务侧只存 SHA-256 哈希）

# ============================================================================
# 上线期启用（部署期变量，00 §2 附表部署期行已登记；开发期不生效，07/08 D12 注释段形态）
# ============================================================================
# WSIM_DEEPSEEK_API_KEY=      # 备用 provider（权限 600、不进 git）
# WSIM_KIMI_API_KEY=          # 备用 provider（权限 600、不进 git）
# WSIM_VLLM_HOSTS=            # 本地 vLLM 三实例地址（safety/fallback/embed；A3 上线期）
# WSIM_INGEST_TOKEN_HASH=     # 云端摄入服务侧：token 的 SHA-256 哈希（04 §9.1；优先于原文派生）
